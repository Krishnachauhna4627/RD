# ─────────────────────────────────────────────────────────────
# Template. Copy to .env and fill in the real values:  cp .env.example .env
# This file IS committed, so it must never contain a real password.
# It exists so everyone knows which keys the app expects.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Where the Angular dev server runs, so the API accepts its calls.
CORS_ORIGIN=http://localhost:4200

# ── MySQL ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306

# The database (schema) name the app uses.
DB_NAME=rd_collections

# The MySQL user the app logs in as, and its password.
DB_USER=
DB_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────
# Secret used to sign login tokens. Use a long random string.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=24h
